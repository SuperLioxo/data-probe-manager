# 本地开发环境配置
# 使用方法: 复制此文件为 application-local.yml 并根据实际情况修改

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/probe_db
    username: probe_user
    password: probe_pass

  redis:
    host: localhost
    port: 6379
    password:

# 日志配置
logging:
  level:
    com.lixin.probe: DEBUG
  file:
    name: ./logs/probe-server.log
