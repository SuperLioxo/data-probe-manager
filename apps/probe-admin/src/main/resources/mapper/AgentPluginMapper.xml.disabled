<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lixin.probe.mapper.AgentPluginMapper">

    <!-- Result Map -->
    <resultMap id="BaseResultMap" type="com.lixin.probe.pojo.AgentPlugin">
        <id column="id" property="id"/>
        <result column="agent_code" property="agentCode"/>
        <result column="agent_host" property="agentHost"/>
        <result column="agent_port" property="agentPort"/>
        <result column="plugin_id" property="pluginId"/>
        <result column="plugin_name" property="pluginName"/>
        <result column="plugin_type" property="pluginType"/>
        <result column="version" property="version"/>
        <result column="db_type" property="dbType"/>
        <result column="version_range" property="versionRange"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="load_time" property="loadTime"/>
        <result column="last_heartbeat" property="lastHeartbeat"/>
        <result column="created_time" property="createdAt"/>
        <result column="updated_time" property="updatedAt"/>
    </resultMap>

    <!-- 查询指定Agent和插件的信息 -->
    <select id="selectByAgentCodeAndPluginId" resultMap="BaseResultMap">
        SELECT *
        FROM t_agent_plugin
        WHERE agent_code = #{agentCode}
          AND plugin_id = #{pluginId}
    </select>

    <!-- 批量查询Agent的多个插件 -->
    <select id="selectByAgentCodeAndPluginIds" resultMap="BaseResultMap">
        SELECT *
        FROM t_agent_plugin
        WHERE agent_code = #{agentCode}
          AND plugin_id IN
        <foreach collection="pluginIds" item="pluginId" open="(" separator="," close=")">
            #{pluginId}
        </foreach>
    </select>

    <!-- 查询指定Agent的所有插件 -->
    <select id="selectByAgentCode" resultMap="BaseResultMap">
        SELECT *
        FROM t_agent_plugin
        WHERE agent_code = #{agentCode}
        ORDER BY created_time DESC
    </select>

    <!-- 更新最后心跳时间 -->
    <update id="updateLastHeartbeat">
        UPDATE t_agent_plugin
        SET last_heartbeat = #{lastHeartbeat},
            updated_time      = #{lastHeartbeat}
        WHERE agent_code = #{agentCode}
          AND plugin_id = #{pluginId}
    </update>

    <!-- 批量更新最后心跳时间 -->
    <update id="batchUpdateLastHeartbeat">
        UPDATE t_agent_plugin
        SET last_heartbeat = #{lastHeartbeat},
            updated_time      = #{lastHeartbeat}
        WHERE agent_code = #{agentCode}
          AND plugin_id IN
        <foreach collection="pluginIds" item="pluginId" open="(" separator="," close=")">
            #{pluginId}
        </foreach>
    </update>

    <!-- 更新插件状态 -->
    <update id="updateStatus">
        UPDATE t_agent_plugin
        SET status     = #{status},
            updated_time = NOW()
        WHERE agent_code = #{agentCode}
          AND plugin_id = #{pluginId}
    </update>

</mapper>
