package com.lixin.probe.agent.plugin;

import com.lixin.probe.agent.pojo.response.ProbeResponse;
import com.lixin.probe.agent.result.CommonResult;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.util.CollectionUtils;

import java.sql.*;
import java.util.*;
import java.util.concurrent.CompletableFuture;
import java.util.stream.Collectors;

/**
 * 抽象数据库插件类
 * 封装数据库操作的通用逻辑
 */
public abstract class AbstractDatabasePlugin implements DatabasePlugin {

    private static final Logger log = LoggerFactory.getLogger(AbstractDatabasePlugin.class);

    /**
     * 获取数据库驱动类（由子类实现）
     */
    protected abstract String getDriverClass();

    @Override
    @SuppressWarnings("unchecked")
    public CompletableFuture<CommonResult<ProbeResponse.Metadata>> getMetadata(Connection connection, Map<String, Object> config) {
        log.info("========== [AbstractDatabasePlugin.getMetadata] 开始获取元数据 ==========");
        log.info("config参数: {}", config.keySet());
        log.info("  - name: {}", config.get("name"));
        log.info("  - type: {}", config.get("type"));
        log.info("  - schemas: {}", config.get("schemas"));

        try {
            String dbName = (String) config.get("name");
            List<String> schemas = (List<String>) config.getOrDefault("schemas", Collections.emptyList());
            List<String> ignore = (List<String>) config.getOrDefault("ignore", Collections.emptyList());

            log.info("开始采集元数据: dbName={}, schemas={}", dbName, schemas);

            DatabaseMetaData metaData = connection.getMetaData();
            schemas = CollectionUtils.isEmpty(schemas) ? Collections.singletonList(null) : schemas;
            Map<String, ProbeResponse.Metadata.Table> tables = new LinkedHashMap<>();

            // 获取数据库基本信息
            String dbVersion = "unknown";
            try {
                dbVersion = metaData.getDatabaseProductVersion();
                log.info("✓ 数据库版本: {}", dbVersion);
            } catch (Exception e) {
                log.warn("✗ 获取数据库版本失败: {}", e.getMessage());
            }

            // 通用表查询逻辑
            for (String schema : schemas) {
                try (ResultSet tableSet = metaData.getTables(dbName, schema, null, new String[]{"TABLE"})) {
                    while (tableSet.next()) {
                        String tableName = tableSet.getString("TABLE_NAME");

                        // 检查是否在忽略列表中
                        if (isTableIgnored(tableName, schema, ignore)) {
                            continue;
                        }

                        try (ResultSet columnSet = metaData.getColumns(dbName, schema, tableName, null)) {
                            Map<String, ProbeResponse.Metadata.Column> columns = new LinkedHashMap<>();
                            while (columnSet.next()) {
                                ProbeResponse.Metadata.Column column = ProbeResponse.Metadata.Column.builder()
                                        .name(columnSet.getString("COLUMN_NAME"))
                                        .comment(columnSet.getString("REMARKS"))
                                        .type(columnSet.getString("TYPE_NAME"))
                                        .build();
                                columns.put(columnSet.getString("COLUMN_NAME"), column);
                            }

                            String fullTableName = schema == null || schema.isEmpty()
                                    ? tableName
                                    : schema + "." + tableName;

                            tables.put(fullTableName, ProbeResponse.Metadata.Table
                                    .builder()
                                    .name(tableName)
                                    .comment(tableSet.getString("REMARKS"))
                                    .columnCount(columns.size())
                                    .columns(columns)
                                    .build());
                        }
                    }
                }
            }

            // 构建元数据响应
            ProbeResponse.Metadata.Database.Builder builder = ProbeResponse.Metadata.Database.builder()
                    .type(getDbType())
                    .version(dbVersion)  // 使用从JDBC获取的实际版本
                    .host(ignore.contains("HOST") ? null : (String) config.get("host"))
                    .port(ignore.contains("PORT") ? null : (Integer) config.get("port"))
                    .username(ignore.contains("USERNAME") ? null : (String) config.get("username"))
                    .password(null) // 不返回密码
                    .name(dbName)
                    .schemas(schemas)
                    .tableCount(tables.size())
                    .columnCount(tables.values().stream().mapToInt(ProbeResponse.Metadata.Table::getColumnCount).sum())
                    .tables(tables);

            // 尝试获取字符集和排序规则（子类可以覆盖）
            log.info("开始获取字符集和排序规则...");
            try {
                log.info("  调用 getDatabaseCharset({})", dbName);
                String charset = getDatabaseCharset(metaData, dbName);
                log.info("  getDatabaseCharset 返回: {}", charset);

                log.info("  调用 getDatabaseCollation({})", dbName);
                String collation = getDatabaseCollation(metaData, dbName);
                log.info("  getDatabaseCollation 返回: {}", collation);

                if (charset != null) {
                    builder.charset(charset);
                    log.info("✓ 数据库字符集已设置: {}", charset);
                } else {
                    log.warn("⚠ 字符集为null，未设置");
                }

                if (collation != null) {
                    builder.collation(collation);
                    log.info("✓ 数据库排序规则已设置: {}", collation);
                } else {
                    log.warn("⚠ 排序规则为null，未设置");
                }
            } catch (Exception e) {
                log.error("✗ 获取字符集/排序规则失败", e);
            }

            ProbeResponse.Metadata.Database database = builder.build();

            log.info("✓ Database 对象构建完成");

            ProbeResponse.Metadata metadata = ProbeResponse.Metadata.builder()
                    .type(getDbType())
                    .databases(Map.of(dbName, database))
                    .build();

            log.info("========== [getMetadata] 构建完成 ==========");
            log.info("返回的 Metadata 对象:");
            log.info("  - type: {}", metadata.getType());
            log.info("  - databases: {}", metadata.getDatabases() != null ? metadata.getDatabases().keySet() : "null");

            if (metadata.getDatabases() != null && !metadata.getDatabases().isEmpty()) {
                ProbeResponse.Metadata.Database db = metadata.getDatabases().values().iterator().next();
                log.info("第一个数据库对象:");
                log.info("  - getType(): {}", db.getType());
                log.info("  - getVersion(): {}", db.getVersion());
                log.info("  - getName(): {}", db.getName());
                log.info("  - getCharset(): {}", db.getCharset());
                log.info("  - getCollation(): {}", db.getCollation());
                log.info("  - getTables(): {}", db.getTables() != null ? db.getTables().size() : "null");
            }

            return CompletableFuture.completedFuture(CommonResult.success("获取元数据成功", metadata));

        } catch (Exception e) {
            log.error("获取{}元数据失败", getDbType(), e);
            return CompletableFuture.completedFuture(
                    CommonResult.fail("获取元数据失败: " + e.getMessage()));
        }
    }

    @Override
    @SuppressWarnings("unchecked")
    public CompletableFuture<CommonResult<ProbeResponse.DataSize>> getDataSize(Connection connection, Map<String, Object> config) {
        try {
            String dbName = (String) config.get("name");
            List<String> schemas = (List<String>) config.get("schemas");
            List<String> ignore = (List<String>) config.getOrDefault("ignore", Collections.emptyList());
            String mode = (String) config.getOrDefault("dataSizeMode", "PRECISE");

            DatabaseMetaData metaData = connection.getMetaData();
            schemas = CollectionUtils.isEmpty(schemas) ? Collections.singletonList(null) : schemas;
            Map<String, ProbeResponse.DataSize.Table> tables = new LinkedHashMap<>();

            for (String schema : schemas) {
                try (ResultSet tableSet = metaData.getTables(dbName, schema, null, new String[]{"TABLE"})) {
                    while (tableSet.next()) {
                        String tableName = tableSet.getString("TABLE_NAME");
                        String schemaName = tableSet.getString("TABLE_SCHEM");

                        // 检查是否在忽略列表中
                        if (isTableIgnored(tableName, schemaName, ignore)) {
                            continue;
                        }

                        Map<String, Object> params = new HashMap<>();
                        params.put("database", dbName);
                        params.put("table", tableName);
                        params.put("schema", schemaName);

                        // 查询行数
                        long rowCount = 0L;
                        String countSql = getCountSql("PRECISE".equals(mode), params);
                        try (Statement stmt = connection.createStatement();
                             ResultSet rs = stmt.executeQuery(countSql)) {
                            if (rs.next()) {
                                rowCount = rs.getLong(1);
                            }
                        }

                        // 查询存储大小
                        long storage = 0L;
                        String storageSql = getStorageSql(params);
                        try (Statement stmt = connection.createStatement();
                             ResultSet rs = stmt.executeQuery(storageSql)) {
                            if (rs.next()) {
                                storage = rs.getLong(1);
                            }
                        }

                        // 获取列数
                        int columnCount = getColumnCount(metaData, dbName, schema, tableName);

                        String fullTableName = (schemaName == null || schemaName.isEmpty())
                                ? tableName
                                : schemaName + "." + tableName;

                        tables.put(fullTableName, ProbeResponse.DataSize.Table
                                .builder()
                                .name(tableName)
                                .columnCount(columnCount)
                                .storage(storage)
                                .rowCount(rowCount)
                                .build());
                    }
                }
            }

            ProbeResponse.DataSize.Database database = ProbeResponse.DataSize.Database.builder()
                    .type(getDbType())
                    .version((String) config.get("version"))
                    .host((String) config.get("host"))
                    .port((Integer) config.get("port"))
                    .username((String) config.get("username"))
                    .password(null)
                    .name(dbName)
                    .schemas(schemas)
                    .tableCount(tables.size())
                    .columnCount(tables.values().stream().mapToInt(ProbeResponse.DataSize.Table::getColumnCount).sum())
                    .storage(tables.values().stream().mapToLong(ProbeResponse.DataSize.Table::getStorage).sum())
                    .rowCount(tables.values().stream().mapToLong(ProbeResponse.DataSize.Table::getRowCount).sum())
                    .tables(tables)
                    .build();

            ProbeResponse.DataSize dataSize = ProbeResponse.DataSize.builder()
                    .databases(Map.of(dbName, database))
                    .build();

            return CompletableFuture.completedFuture(CommonResult.success("获取数据量成功", dataSize));

        } catch (Exception e) {
            log.error("获取{}数据量失败", getDbType(), e);
            return CompletableFuture.completedFuture(
                    CommonResult.fail("获取数据量失败: " + e.getMessage()));
        }
    }

    @Override
    public CommonResult<Connection> getConnection(String url, String username, String password) {
        try {
            Class.forName(getDriverClass());
            Connection conn = DriverManager.getConnection(url, username, password);

            if (conn == null || conn.isClosed()) {
                return CommonResult.fail("创建的连接为空或已关闭");
            }

            log.info("{}数据库连接成功 | URL: {}", getDbType(), url);
            return CommonResult.success("数据库连接成功", conn);

        } catch (ClassNotFoundException e) {
            log.error("{}驱动加载失败 | 驱动类: {}", getDbType(), getDriverClass(), e);
            return CommonResult.fail("驱动加载失败: " + e.getMessage());

        } catch (SQLException e) {
            log.error("{}数据库连接失败 | URL: {}", getDbType(), url, e);
            return CommonResult.fail("数据库连接失败: " + e.getMessage());

        } catch (Exception e) {
            log.error("{}数据库连接异常", getDbType(), e);
            return CommonResult.fail("数据库连接异常: " + e.getMessage());
        }
    }

    /**
     * 获取表的列数
     */
    protected int getColumnCount(DatabaseMetaData metaData, String dbName, String schema, String tableName) throws SQLException {
        try (ResultSet columnSet = metaData.getColumns(dbName, schema, tableName, null)) {
            int count = 0;
            while (columnSet.next()) {
                count++;
            }
            return count;
        }
    }

    /**
     * 判断表是否应该被忽略
     */
    protected boolean isTableIgnored(String tableName, String schema, List<String> ignoreTables) {
        if (CollectionUtils.isEmpty(ignoreTables)) {
            return false;
        }

        String fullTableName = (schema == null || schema.isEmpty()) ? tableName : schema + "." + tableName;

        for (String ignoreRule : ignoreTables) {
            if (ignoreRule == null || ignoreRule.trim().isEmpty()) {
                continue;
            }
            ignoreRule = ignoreRule.trim();

            // 精确匹配
            if (ignoreRule.equals(tableName) || ignoreRule.equals(fullTableName)) {
                return true;
            }

            // 前缀匹配
            if (ignoreRule.endsWith("*")) {
                String prefix = ignoreRule.substring(0, ignoreRule.length() - 1);
                if (tableName.startsWith(prefix) || fullTableName.startsWith(prefix)) {
                    return true;
                }
            }

            // 后缀匹配
            if (ignoreRule.startsWith("*")) {
                String suffix = ignoreRule.substring(1);
                if (tableName.endsWith(suffix) || fullTableName.endsWith(suffix)) {
                    return true;
                }
            }
        }

        return false;
    }

    /**
     * 验证SQL标识符的安全性
     * 只允许字母、数字、下划线和点号（用于schema.table格式）
     *
     * @param identifier 要验证的标识符
     * @return 如果安全返回true，否则返回false
     */
    protected boolean isValidSqlIdentifier(String identifier) {
        if (identifier == null || identifier.isEmpty()) {
            return false;
        }

        // SQL标识符只允许：字母、数字、下划线、点号、美元符号、井号
        // 这里采用更严格的策略：只允许字母、数字、下划线和点号
        String pattern = "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$";

        if (!identifier.matches(pattern)) {
            log.warn("检测到潜在的SQL注入风险，无效的SQL标识符: {}", identifier);
            return false;
        }

        return true;
    }

    /**
     * 转义SQL标识符，防止SQL注入
     * 如果标识符不安全，将抛出IllegalArgumentException
     *
     * @param identifier 要转义的标识符
     * @return 转义后的安全标识符
     * @throws IllegalArgumentException 如果标识符不安全
     */
    protected String escapeSqlIdentifier(String identifier) {
        if (!isValidSqlIdentifier(identifier)) {
            throw new IllegalArgumentException("无效的SQL标识符，可能存在SQL注入风险: " + identifier);
        }
        return identifier;
    }

    /**
     * 获取数据库字符集
     * 子类可以覆盖此方法以提供特定数据库的实现
     *
     * @param metaData 数据库元数据
     * @param dbName 数据库名称
     * @return 字符集，如果无法获取则返回null
     */
    protected String getDatabaseCharset(DatabaseMetaData metaData, String dbName) {
        // 默认实现：尝试通过查询获取
        // 子类（如MySQL、PostgreSQL）可以覆盖此方法
        return null;
    }

    /**
     * 获取数据库排序规则
     * 子类可以覆盖此方法以提供特定数据库的实现
     *
     * @param metaData 数据库元数据
     * @param dbName 数据库名称
     * @return 排序规则，如果无法获取则返回null
     */
    protected String getDatabaseCollation(DatabaseMetaData metaData, String dbName) {
        // 默认实现：尝试通过查询获取
        // 子类（如MySQL、PostgreSQL）可以覆盖此方法
        return null;
    }
}
